{
  "name": "stylebound-workspace",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Checks technical writing against plain-English rules, exports the fixes for any person or agent, and verifies that no fact was lost.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 && node scripts/typecheck.js",
    "scan": "node scripts/scan-forbidden.js",
    "typecheck": "node scripts/typecheck.js",
    "golden": "node scripts/update-golden.mjs",
    "regress": "node scripts/regress.mjs",
    "rules:lock": "node scripts/rules-lock.js",
    "rules:report": "node scripts/rules-report.js",
    "bench": "node scripts/bench.mjs",
    "examples": "node scripts/update-examples.mjs",
    "gate": "node scripts/gate.mjs",
    "trial": "node scripts/trial.mjs",
    "precision": "node scripts/precision.mjs",
    "fixtures:docx": "node scripts/make-docx-fixtures.mjs",
    "build:npm": "node scripts/build-npm.mjs",
    "test:pack": "node scripts/pack-check.mjs"
  }
}
