{
  "name": "stylebound-workspace",
  "version": "1.0.0-rc.1",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "stylebound-workspace",
      "version": "1.0.0-rc.1",
      "license": "MIT",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/stylebound": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/stylebound-core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "stylebound",
      "version": "1.0.0-rc.1",
      "license": "MIT",
      "bin": {
        "stylebound": "bin/stylebound.mjs"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/core": {
      "name": "stylebound-core",
      "version": "1.0.0-rc.1",
      "license": "MIT"
    }
  }
}
