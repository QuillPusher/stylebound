# Files that stay on your machine. Git never uploads a file that matches these
# patterns. Tracked files are not affected: untrack them with "git rm --cached".

# Rebuilt by the setup steps (README, "Move, copy or clone").
node_modules/
release/

# Packed or bundled copies of the package or the repository.
*.bundle
*.tgz

# Local HTML pages that are not part of the repository.
*-explainer.html
*-explainer-src/
docs/publishing.html
docs/publishing-src/

# Review and report files that Stylebound writes next to the documents you check.
# The sample outputs in examples/ stay in the repository.
*.style-review.json
*.style-review.md
*.style-check.html
*.style-verify.html
!examples/*.style-*

# Operating system, editor and npm log files.
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
npm-debug.log*
